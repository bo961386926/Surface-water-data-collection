    <td class="xl92" x:fmla="=MIN(O4:O6)" x:num>80</td>
   </tr>
   <![if supportMisalignedColumns]>
    <tr width="0" style='display:none;'>
     <td width="112" style='width:84;'></td>
     <td width="106" style='width:80;'></td>
     <td width="72" style='width:54;'></td>
    </tr>
   <![endif]>
  </table>
 </body>
</html>
